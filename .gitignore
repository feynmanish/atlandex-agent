# Secrets and local config
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/

# Runtime artifacts
.cache/

# Raw per-query results hold full answers and can be large; summaries are kept.
eval/results/*/records.jsonl*

# Eval runs are scratch by default. Only the runs the README cites are kept:
# baseline, fixed v1, fixed v2. Publish a new run by adding a "!" line here.
eval/results/*
!eval/results/20261011-125600/
!eval/results/20261012-062749/
!eval/results/20261012-fixed-v2/
