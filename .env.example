# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Base URL of the Atlandex backend's /api routes (the variable atlandex-mcp reads)
ATLANDEX_API_URL=

# Paid-call lock: leave false until you approve paid models.
ALLOW_PAID=false
BUDGET_USD=0

# Optional Langfuse tracing (pip install -e ".[tracing]"). Leave the keys empty to run without it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Command that launches atlandex-mcp over stdio (path to its installed entry point)
ATLANDEX_MCP_COMMAND=atlandex-mcp

# Optional: the multi-agent variant (supervisor + search agent + verification agent). Defaults are in config.py.
# AGENT_ARCH=single
# SEARCH_STEPS_PER_TASK=3
# MAX_SUPERVISOR_TURNS=3
# VERIFY_MAX_TOKENS=
# MAX_LLM_CALLS_PER_RUN=13
